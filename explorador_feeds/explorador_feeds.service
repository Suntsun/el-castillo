[Unit]
Description=Actualizacion diaria de feeds RSS
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/Escritorio/automatizaciones/explorador_feeds/explorador_feeds.py --actualizar
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
